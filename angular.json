{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "portafolio": {
      "projectType": "application",

      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },

      "root": "",
      "sourceRoot": "src",
      "prefix": "app",

      "architect": {
        "build": {
          "builder": "@angular/build:application",

          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",

            "stylePreprocessorOptions": {
              "includePaths": [
                "src/styles"
              ]
            },

            "assets": [
              {
                "glob": "**/*",
                "input": "src/assets",
                "output": "assets"
              }
            ],

            "styles": [
              "src/styles.scss"
            ],

            "server": "src/main.server.ts",
            "outputMode": "server",

            "security": {
              "allowedHosts": []
            },

            "ssr": {
              "entry": "src/server.ts"
            }
          },

          "configurations": {
            "production": {
              "fileReplacements": [
                {
                  "replace": "src/env/environment.ts",
                  "with": "src/env/environment.prod.ts"
                }
              ],

              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],

              "outputHashing": "all"
            },

            "development": {
              "fileReplacements": [
                {
                  "replace": "src/env/environment.ts",
                  "with": "src/env/environment.development.ts"
                }
              ],

              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },

          "defaultConfiguration": "production"
        },

        "serve": {
          "builder": "@angular/build:dev-server",

          "configurations": {
            "production": {
              "buildTarget": "portafolio:build:production"
            },

            "development": {
              "buildTarget": "portafolio:build:development"
            }
          },

          "defaultConfiguration": "development"
        },

        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}
